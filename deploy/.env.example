# Copy to deploy/.env (never committed). Guide: docs/deploy.md

# Public URL as typed by players, without trailing slash.
# VPS: https://<sous-domaine>.duckdns.org — local fallback: http://<IP de l'ordinateur sur le réseau>
APP_URL=https://etic-game.duckdns.org
# What Caddy listens on. VPS: the domain alone (HTTPS certificate is automatic).
# Local fallback: ":80" (plain HTTP on the LAN).
SITE_ADDRESS=etic-game.duckdns.org
# "https" starts Caddy. Leave empty if the VPS already has a reverse proxy (docs/deploy.md).
COMPOSE_PROFILES=https

# Generate with: openssl rand -hex 32 (hex only: the password goes into a URL).
POSTGRES_PASSWORD=
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Comma-separated organizer emails. Create these accounts right after the first deploy.
ORGANIZER_EMAILS=

# Google sign-in, enabled only when both are set. Redirect URI to register in Google Cloud:
# <APP_URL>/api/auth/callback/google — leave empty for the local fallback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional
# LOG_LEVEL=info
# APP_BIND=127.0.0.1:3000
# BACKUP_KEEP=7
# POSTGRES_USER=etic
# POSTGRES_DB=etic
