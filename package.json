{
  "name": "etic-business-game",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "bun run --filter @etic/server dev",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "bun run --filter @etic/server db:generate",
    "db:migrate": "bun run --filter @etic/server db:migrate",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test",
    "sim": "bun packages/engine/src/sim/run.ts",
    "dev": "bun run --filter '@etic/server' --filter '@etic/web' dev",
    "demo": "bun --env-file=.env apps/server/src/demo.ts",
    "demo:film": "bun --env-file=.env apps/server/src/demo-film/server.ts",
    "dev:web": "bun run --filter @etic/web dev",
    "build": "bun run --filter @etic/web build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
