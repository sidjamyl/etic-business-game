# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (docker compose service "db", exposed on 5433 to avoid clashing with a local Postgres)
DATABASE_URL=postgres://etic:etic@localhost:5433/etic

# Public URL of the app as seen by browsers.
# Development: the Vite dev server (5173), which proxies /api to this server.
# Production: the public HTTPS URL.
APP_URL=http://localhost:5173
# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-secret-of-32-chars-min
# Comma-separated emails that get the organizer role
ORGANIZER_EMAILS=
# Google sign-in is enabled only when both are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
